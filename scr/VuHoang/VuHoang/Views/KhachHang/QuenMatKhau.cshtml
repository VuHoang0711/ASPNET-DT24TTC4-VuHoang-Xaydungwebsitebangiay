@model CakeShop.ModelsView.ForgotPassword.QuenMatKhau
@{
	ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="p-4 p-md-5 rounded" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-md); border-radius: 24px;">
                <div class="text-center mb-4">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background: #FFEFEA; color: #FF6F59; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px;">
                        <i class="fa fa-envelope-o"></i>
                    </div>
                    <h3 class="font-weight-bold" style="color: var(--brand-brown-dark);">QUÊN MẬT KHẨU?</h3>
                    <p class="text-muted small">Nhập địa chỉ email đăng ký tài khoản Sneaker Store, chúng tôi sẽ gửi mã xác thực OTP để bạn đặt lại mật khẩu mới.</p>
                </div>

                <form asp-action="QuenMatKhau" asp-controller="KhachHang" method="post">
                    <div class="form-group mb-4">
                        <label class="font-weight-bold small text-muted">EMAIL ĐĂNG KÝ <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" name="email" class="form-control" placeholder="example@email.com" required />
                        <div class="text-danger small mt-2" asp-validation-summary="All"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a class="btn btn-teahouse-outline" asp-action="DangNhap" asp-controller="KhachHang">
                            Quay lại đăng nhập
                        </a>
                        <button type="submit" class="btn-teahouse px-4 py-2">
                            GỬI MÃ OTP
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
