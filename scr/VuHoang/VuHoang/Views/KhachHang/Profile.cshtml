@model CakeShop.ModelsView.ThayDoiThongTinVM;
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-5">
    <div class="row">
        <!-- Account Sidebar Navigation -->
        <div class="col-12 col-lg-4 mb-4">
            <div class="account-sidebar-nav">
                <!-- User summary -->
                <div class="text-center p-3 mb-3 border-bottom">
                    <div style="width: 100px; height: 100px; margin: 0 auto 12px; border-radius: 50%; overflow: hidden; border: 3px solid var(--brand-caramel); box-shadow: var(--shadow-sm);">
                        <img class="avatar-img" src="~/Hinh/KhachHang/@Model.Hinh" alt="Avatar" onerror="this.src='/img/core-img/user.svg';" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <h5 class="font-weight-bold mb-1" style="color: var(--brand-brown-dark);">@Model.HoTen</h5>
                    <span class="badge badge-pill" style="background: var(--brand-peach-soft); color: var(--brand-peach); font-weight: 700;">Thành Viên Thân Thiết</span>
                </div>

                <nav class="nav flex-column">
                    <a class="account-nav-link active" asp-controller="KhachHang" asp-action="Profile">
                        <i class="fa fa-user-circle-o"></i> Thông tin cá nhân
                    </a>
                    <a class="account-nav-link" asp-controller="Cart" asp-action="HistoryBill">
                        <i class="fa fa-shopping-bag"></i> Đơn hàng của tôi
                    </a>
                    <a class="account-nav-link" asp-controller="HangHoa" asp-action="Index">
                        <i class="fa fa-heart-o"></i> Sản phẩm yêu thích
                    </a>
                    <a class="account-nav-link" asp-controller="KhachHang" asp-action="DoiMatKhau">
                        <i class="fa fa-lock"></i> Đổi mật khẩu
                    </a>
                    <a class="account-nav-link text-danger" asp-controller="KhachHang" asp-action="DangXuat">
                        <i class="fa fa-sign-out"></i> Đăng xuất
                    </a>
                </nav>
            </div>
        </div>

        <!-- Account Profile Form -->
        <div class="col-12 col-lg-8">
            <div class="p-4 rounded" style="background:#FFFFFF; border:1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                    <div>
                        <h4 class="font-weight-bold mb-1" style="color: var(--brand-brown-dark);">Thông Tin Tài Khoản</h4>
                        <p class="text-muted small mb-0">Cập nhật thông tin giao nhận và liên hệ để nhận ưu đãi giày thể thao nhanh nhất</p>
                    </div>
                </div>

                <form action="ThayDoiThongTin" method="post" enctype="multipart/form-data">
                    <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">MÃ KHÁCH HÀNG</label>
                            <input type="text" asp-for="@Model.MaKh" class="form-control" readonly style="background: #F8F9FA;" />
                            <span asp-validation-for="@Model.MaKh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">HỌ VÀ TÊN <span class="text-danger">*</span></label>
                            <input type="text" asp-for="@Model.HoTen" name="HoTen" class="form-control" value="@Model.HoTen" required />
                            <span asp-validation-for="@Model.HoTen" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">GIỚI TÍNH</label>
                            <div class="d-flex align-items-center mt-2" style="gap: 20px;">
                                <div class="custom-control custom-radio">
                                    <input type="radio" class="custom-control-input" name="GioiTinh" id="nam" value="true" @(Model.GioiTinh ? "checked" : "")>
                                    <label class="custom-control-label font-weight-bold" for="nam">Nam</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" class="custom-control-input" name="GioiTinh" id="nu" value="false" @(!Model.GioiTinh ? "checked" : "")>
                                    <label class="custom-control-label font-weight-bold" for="nu">Nữ</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">NGÀY SINH</label>
                            <input type="date" asp-for="@Model.NgaySinh" name="NgaySinh" class="form-control" value="@Model.NgaySinh.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="@Model.NgaySinh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">SỐ ĐIỆN THOẠI <span class="text-danger">*</span></label>
                            <input type="tel" asp-for="@Model.DienThoai" name="DienThoai" class="form-control" value="@Model.DienThoai" required />
                            <span asp-validation-for="@Model.DienThoai" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold small text-muted">EMAIL LIÊN HỆ <span class="text-danger">*</span></label>
                            <input type="email" asp-for="@Model.Email" name="Email" class="form-control" value="@Model.Email" required />
                            <span asp-validation-for="@Model.Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="font-weight-bold small text-muted">ĐỊA CHỈ NHẬN HÀNG <span class="text-danger">*</span></label>
                            <input type="text" asp-for="@Model.DiaChi" name="DiaChi" class="form-control" value="@Model.DiaChi" required />
                            <span asp-validation-for="@Model.DiaChi" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 mb-4">
                            <label class="font-weight-bold small text-muted">HÌNH ẢNH ĐẠI DIỆN</label>
                            <input type="file" asp-for="@Model.Hinh" name="Hinh" class="form-control file-upload" accept=".png, .jpg, .jpeg" />
                            <span asp-validation-for="@Model.Hinh" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <button type="submit" class="btn-teahouse px-4 py-3">
                                <i class="fa fa-save mr-2"></i> LƯU THAY ĐỔI THÔNG TIN
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var readURL = function (input) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('.avatar-img').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(input.files[0]);
                }
            }
            $(".file-upload").on('change', function () {
                readURL(this);
            });
        });
    </script>
}