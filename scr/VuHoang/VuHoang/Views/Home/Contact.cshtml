@{
    ViewData["Title"] = "Liên hệ - Hệ thống cửa hàng giày Sneaker Store";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge badge-pill px-3 py-2 mb-2" style="background: var(--brand-peach-soft); color: var(--brand-peach); font-weight: 700; font-size: 13px;">
            KẾT NỐI CÙNG SNEAKER STORE
        </span>
        <h1 class="font-weight-bold" style="color: var(--brand-brown-dark); font-size: 2.6rem;">LIÊN HỆ & SHOWROOM</h1>
        <p class="text-muted">Ghé thăm cửa hàng thử giày trực tiếp hoặc liên hệ để được tư vấn chọn size chuẩn nhất</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4 mb-4">
            <div class="p-4 rounded text-center h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #F1F5F9; color: var(--brand-brown); display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
                    <i class="fa fa-map-marker"></i>
                </div>
                <h5 class="font-weight-bold" style="color: var(--brand-brown-dark);">Địa Chỉ Cửa Hàng</h5>
                <p class="text-muted small mb-0">129 Đ. Số 8, Linh Xuân, TP. Thủ Đức, TP. Hồ Chí Minh</p>
                <div class="mt-2 text-success small font-weight-bold">Có khu vực thử giày & bãi đỗ xe miễn phí</div>
            </div>
        </div>

        <div class="col-12 col-md-4 mb-4">
            <div class="p-4 rounded text-center h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #FFF1F0; color: #FF4D2D; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
                    <i class="fa fa-phone"></i>
                </div>
                <h5 class="font-weight-bold" style="color: var(--brand-brown-dark);">Hotline Tư Vấn Size & Đổi Trả</h5>
                <p class="text-muted small mb-0">Hỗ trợ chọn size giày & tra cứu đơn hàng:</p>
                <h4 class="mt-2 font-weight-bold" style="color: var(--brand-peach);">1900 6888</h4>
                <div class="text-muted small">8:00 - 22:30 mỗi ngày</div>
            </div>
        </div>

        <div class="col-12 col-md-4 mb-4">
            <div class="p-4 rounded text-center h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
                    <i class="fa fa-envelope-o"></i>
                </div>
                <h5 class="font-weight-bold" style="color: var(--brand-brown-dark);">Email Chăm Sóc Khách Hàng</h5>
                <p class="text-muted small mb-0">Liên hệ đặt hàng đội nhóm hoặc hợp tác:</p>
                <div class="mt-2 font-weight-bold" style="color: var(--brand-brown);">contact@sneakerstore.vn</div>
                <div class="text-muted small">Phản hồi nhanh trong 2 giờ</div>
            </div>
        </div>
    </div>

    <!-- Map & Form -->
    <div class="row g-4 align-items-stretch">
        <div class="col-12 col-lg-7 mb-4">
            <div class="rounded overflow-hidden h-100" style="border: 1px solid var(--border-soft); border-radius: 20px; box-shadow: var(--shadow-sm); min-height: 420px;">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d244.88262655859805!2d106.7764604960055!3d10.878322520646462!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d9db5b6e66fb%3A0x149e1a0627fca2!2zVGnhu4dtIELDoW5oIE1pTWk!5e0!3m2!1svi!2s!4v1718909426313!5m2!1svi!2s" width="100%" height="100%" style="border:0; min-height: 420px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>

        <div class="col-12 col-lg-5 mb-4">
            <div class="p-4 p-md-5 rounded h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                <h4 class="font-weight-bold mb-3" style="color: var(--brand-brown-dark);">Gửi Yêu Cầu Tư Vấn Chọn Giày</h4>
                <p class="text-muted small mb-4">Bạn cần tư vấn chọn size giày chạy bộ, bóng rổ hay kiểm tra tình trạng size tại cửa hàng?</p>
                <form onsubmit="alert('Cảm ơn bạn đã gửi lời nhắn! Đội ngũ tư vấn của Sneaker Store sẽ liên hệ hỗ trợ bạn ngay.'); return false;">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted">HỌ VÀ TÊN</label>
                        <input type="text" class="form-control" placeholder="Họ và tên của bạn" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted">SỐ ĐIỆN THOẠI</label>
                        <input type="tel" class="form-control" placeholder="Số điện thoại liên hệ" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-muted">LỜI NHẮN</label>
                        <textarea class="form-control" rows="3" placeholder="Mẫu giày và size bạn cần Sneaker Store tư vấn..." required></textarea>
                    </div>
                    <button type="submit" class="btn-teahouse w-100 py-3">
                        <i class="fa fa-paper-plane mr-1"></i> GỬI TIN NHẮN
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
