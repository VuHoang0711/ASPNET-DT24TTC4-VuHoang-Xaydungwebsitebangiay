@{
    ViewData["Title"] = "Hướng dẫn chọn size giày & Mua hàng - Sneaker Store";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge badge-pill px-3 py-2 mb-2" style="background: var(--brand-peach-soft); color: var(--brand-peach); font-weight: 700; font-size: 13px;">
            CHỌN SIZE CHUẨN & ĐẶT HÀNG NHANH
        </span>
        <h1 class="font-weight-bold" style="color: var(--brand-brown-dark); font-size: 2.6rem;">HƯỚNG DẪN CHỌN SIZE & MUA GIÀY ONLINE</h1>
        <p class="text-muted">4 bước đơn giản để chọn đúng kích cỡ bàn chân và đặt mua đôi giày thể thao yêu thích tại Sneaker Store</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="row g-4">
                <!-- Step 1 -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="p-4 rounded h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #F1F5F9; color: var(--brand-brown); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px;" class="mr-3">
                                1
                            </div>
                            <h5 class="font-weight-bold mb-0" style="color: var(--brand-brown-dark);">Tìm Mẫu Giày Theo Nhu Cầu</h5>
                        </div>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Duyệt theo danh mục <strong>Giày Nike, Giày Adidas, Giày chạy bộ, Giày bóng rổ</strong> hoặc <strong>Sneaker Lifestyle</strong>. Sử dụng bộ lọc theo giới tính (Nam, Nữ, Unisex) và khoảng giá để tìm nhanh mẫu giày phù hợp.
                        </p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="p-4 rounded h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #FFF1F0; color: #FF4D2D; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px;" class="mr-3">
                                2
                            </div>
                            <h5 class="font-weight-bold mb-0" style="color: var(--brand-brown-dark);">Chọn Size Giày EU (36 - 45) & Phối Màu</h5>
                        </div>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Đo chiều dài bàn chân từ gót đến ngón dài nhất (ví dụ: 22.5cm = Size 36, 25cm = Size 40, 26.5cm = Size 42, 28cm = Size 44). Đối với giày chạy bộ hoặc bàn chân bè, bạn nên tăng thêm 0.5 - 1 size để thoải mái vận động.
                        </p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="p-4 rounded h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #FFF7ED; color: #EA580C; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px;" class="mr-3">
                                3
                            </div>
                            <h5 class="font-weight-bold mb-0" style="color: var(--brand-brown-dark);">Kiểm Tra Giỏ Hàng & Thanh Toán</h5>
                        </div>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Kiểm tra lại mẫu giày, size đã chọn và số lượng trong giỏ hàng. Điền địa chỉ nhận hàng và chọn thanh toán tiền mặt khi nhận hàng (<strong>COD</strong>) hoặc thanh toán qua <strong>VNPay</strong>.
                        </p>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="p-4 rounded h-100" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px;" class="mr-3">
                                4
                            </div>
                            <h5 class="font-weight-bold mb-0" style="color: var(--brand-brown-dark);">Nhận Hàng Double-Box & Đổi Size 30 Ngày</h5>
                        </div>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Giày được đóng gói 2 lớp hộp bảo vệ. Quý khách được kiểm tra đúng mẫu, đúng size khi nhận hàng và được hỗ trợ đổi size trong vòng 30 ngày nếu mang chưa vừa chân.
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" asp-controller="HangHoa" class="btn-teahouse px-5 py-3">
                    <i class="fa fa-shopping-bag mr-2"></i> CHỌN GIÀY NGAY
                </a>
            </div>
        </div>
    </div>
</div>
