@{
    ViewData["Title"] = "Không tìm thấy trang - Sneaker Store";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="p-5 rounded" style="background: #FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-md); border-radius: 24px;">
                <div style="font-size: 70px; color: var(--brand-peach); margin-bottom: 10px;">
                    <i class="fas fa-running"></i>
                </div>
                <h1 class="display-3 font-weight-bold" style="color: var(--brand-brown-dark);">404</h1>
                <h3 class="font-weight-bold mb-3" style="color: var(--brand-brown);">Trang Không Tồn Tại</h3>
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-warning py-2 mb-3 small">@TempData["Message"]</div>
                }
                <p class="text-muted mb-4">
                    Mẫu giày thể thao bạn đang tìm kiếm có thể đã chuyển danh mục hoặc tạm hết hàng. Hãy quay về trang chủ để khám phá bộ sưu tập sneaker mới nhất nhé!
                </p>
                <a class="btn-teahouse px-5 py-3" asp-controller="Home" asp-action="Index">
                    <i class="fa fa-home mr-2"></i> VỀ TRANG CHỦ
                </a>
            </div>
        </div>
    </div>
</div>
