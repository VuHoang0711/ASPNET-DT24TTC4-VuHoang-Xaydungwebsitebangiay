@{
    ViewData["Title"] = "Về chúng tôi - Hệ thống Sneaker Store";
}

<div class="single-blog-wrapper" style="background: var(--bg-primary);">
    <!-- Single Blog Post Thumb -->
    <div class="single-blog-post-thumb" style="max-height: 480px; overflow: hidden; position: relative;">
        <img src="~/img/bg-img/about-sneaker.jpg" style="width: 100%; height: 480px; object-fit: cover;" alt="Hệ thống cửa hàng giày thể thao Sneaker Store" onerror="this.src='/img/bg-img/sneaker-hero.jpg';" />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(17, 24, 39, 0.2) 0%, rgba(17, 24, 39, 0.85) 100%); display: flex; align-items: flex-end; padding: 60px;">
            <div class="container text-white">
                <span class="badge badge-pill mb-2 px-3 py-1 font-weight-bold" style="background: var(--brand-peach); font-size: 13px;">
                    CÂU CHUYỆN THƯƠNG HIỆU
                </span>
                <h1 class="text-white font-weight-bold" style="font-size: 2.8rem;">HÀNH TRÌNH LAN TỎA VĂN HÓA SNEAKER & THỂ THAO</h1>
                <p class="text-white-50 mb-0 font-weight-bold">Đồng hành cùng từng bước chạy và phong cách đường phố của giới trẻ Việt Nam.</p>
            </div>
        </div>
    </div>

    <!-- Content Wrap -->
    <div class="container py-5">
        <div class="row">
            <!-- Main Content -->
            <div class="col-12 col-lg-8">
                <div class="p-4 p-md-5 rounded" style="background: #FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 24px;">
                    <h3 class="font-weight-bold mb-4" style="color: var(--brand-brown-dark);">
                        Khởi Nguồn Từ Đam Mê Giày Thể Thao & Streetwear
                    </h3>
                    <p style="line-height: 1.8; color: var(--text-secondary); font-size: 16px;">
                        Được thành lập với sứ mệnh mang đến những đôi giày thể thao chất lượng và hợp xu hướng nhất, <strong>SNEAKER STORE</strong> quy tụ đầy đủ các dòng giày từ Nike, Adidas, Puma, New Balance, Converse, Vans đến Asics. Chúng tôi tin rằng một đôi giày phù hợp không chỉ bảo vệ đôi chân mà còn thể hiện cá tính riêng biệt của bạn trên mọi cung đường.
                    </p>

                    <blockquote class="my-4 p-4 rounded" style="background: #F8FAFC; border-left: 4px solid var(--brand-peach);">
                        <h6 style="color: var(--brand-brown); font-style: italic; line-height: 1.7; font-size: 16px;">
                            <i class="fa fa-quote-left text-danger mr-2"></i> “Một đôi giày tốt sẽ đưa bạn đến những nơi tuyệt vời. Chúng tôi chăm chút từ việc tư vấn chuẩn size, đóng gói Double-Box đến chế độ hậu mãi để mỗi bước chân của bạn luôn tràn đầy tự tin.”
                        </h6>
                        <span class="font-weight-bold text-dark small">— Đội ngũ sáng lập Sneaker Store</span>
                    </blockquote>

                    <h4 class="font-weight-bold mt-5 mb-3" style="color: var(--brand-brown);">
                        1. Đa Dạng Thương Hiệu & Dòng Giày Thể Thao
                    </h4>
                    <p style="line-height: 1.8; color: var(--text-secondary);">
                        Từ những đôi sneaker biểu tượng như Nike Air Force 1, Dunk Low, Air Jordan 1, Adidas Samba OG, Gazelle, Campus 00s cho đến các mẫu giày chạy bộ hiệu năng cao như Nike Pegasus 41, Adidas Ultraboost và Asics GEL-Kayano 30 đều luôn sẵn sàng đủ size nam nữ từ 36 đến 45.
                    </p>

                    <h4 class="font-weight-bold mt-5 mb-3" style="color: var(--brand-brown);">
                        2. Hỗ Trợ Đổi Size Linh Hoạt Trong 30 Ngày
                    </h4>
                    <p style="line-height: 1.8; color: var(--text-secondary);">
                        Hiểu được nỗi lo chọn nhầm size khi mua giày online, Sneaker Store áp dụng chính sách hỗ trợ đổi size miễn phí trong vòng 30 ngày cùng chế độ bảo hành keo và đế giày 12 tháng, mang lại sự an tâm tối đa cho khách hàng.
                    </p>

                    <h4 class="font-weight-bold mt-5 mb-3" style="color: var(--brand-brown);">
                        3. Quy Trình Đóng Gói Double-Box Tiêu Chuẩn
                    </h4>
                    <p style="line-height: 1.8; color: var(--text-secondary);">
                        Mọi đơn hàng tại Sneaker Store đều được bọc giấy chống ẩm và đóng gói 2 lớp hộp (Double-Box) cứng cáp, giữ cho hộp giày nguyên bản luôn vuông vức khi giao tới tay những tín đồ sưu tầm sneaker.
                    </p>
                </div>
            </div>

            <!-- Sidebar Posts -->
            <div class="col-12 col-lg-4 mt-4 mt-lg-0">
                <div class="p-4 rounded mb-4" style="background: #FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); border-radius: 20px;">
                    <h5 class="font-weight-bold mb-3 pb-2 border-bottom" style="color: var(--brand-brown-dark);">
                        MẪU GIÀY ĐƯỢC YÊU THÍCH
                    </h5>

                    <div class="d-flex align-items-center mb-3">
                        <img src="~/Hinh/HangHoa/nike-af1-07.jpg" class="rounded mr-3" style="width: 70px; height: 70px; object-fit: cover;" alt="Nike Air Force 1 '07" />
                        <div>
                            <a asp-action="Detail" asp-controller="HangHoa" asp-route-id="1" class="font-weight-bold d-block" style="color: var(--brand-brown-dark); font-size: 14px;">
                                Nike Air Force 1 '07
                            </a>
                            <span class="text-danger font-weight-bold small">2.720.000đ</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <img src="~/Hinh/HangHoa/adidas-samba-og.jpg" class="rounded mr-3" style="width: 70px; height: 70px; object-fit: cover;" alt="Adidas Samba OG" />
                        <div>
                            <a asp-action="Detail" asp-controller="HangHoa" asp-route-id="6" class="font-weight-bold d-block" style="color: var(--brand-brown-dark); font-size: 14px;">
                                Adidas Samba OG
                            </a>
                            <span class="text-danger font-weight-bold small">3.000.000đ</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <img src="~/Hinh/HangHoa/nb-530.jpg" class="rounded mr-3" style="width: 70px; height: 70px; object-fit: cover;" alt="New Balance 530" />
                        <div>
                            <a asp-action="Detail" asp-controller="HangHoa" asp-route-id="13" class="font-weight-bold d-block" style="color: var(--brand-brown-dark); font-size: 14px;">
                                New Balance 530 White Silver
                            </a>
                            <span class="text-danger font-weight-bold small">2.750.000đ</span>
                        </div>
                    </div>
                </div>

                <div class="p-4 rounded text-center" style="background: linear-gradient(135deg, #FFF1F0 0%, #FFF7ED 100%); border: 1.5px dashed var(--brand-peach); border-radius: 20px;">
                    <i class="fas fa-running fa-3x mb-3" style="color: var(--brand-peach);"></i>
                    <h5 class="font-weight-bold" style="color: var(--brand-brown-dark);">Tìm Đôi Giày Của Bạn?</h5>
                    <p class="small text-muted">Đặt hàng ngay hôm nay để nhận ưu đãi miễn phí vận chuyển và đổi size trong 30 ngày!</p>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn-teahouse w-100 py-2">
                        KHÁM PHÁ NGAY
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
