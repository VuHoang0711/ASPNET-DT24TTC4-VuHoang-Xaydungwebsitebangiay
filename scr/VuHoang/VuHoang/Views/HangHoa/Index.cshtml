@model IEnumerable<CakeShop.ModelsView.HangHoaVM>
@{
   ViewData["Title"] = "Bộ Sưu Tập Giày Thể Thao & Sneaker";
   Layout = "_DanhSachHangHoa";
}
<!-- Sneaker Store Product Header start -->
@section BreadCum
{
    <div class="breadcumb_area"
         style="background: linear-gradient(135deg, rgba(17, 24, 39, 0.85) 0%, rgba(31, 41, 55, 0.78) 100%), url('/img/bg-img/sneaker-banner.jpg') center/cover; padding: 70px 0;">
        <div class="container h-100">
            <div class="row h-100 align-items-center">
                <div class="col-12 text-center text-white">
                    <span class="badge badge-pill mb-2 px-3 py-2" style="background: var(--brand-peach); font-size: 13px; font-weight: 700; letter-spacing: 1px;">
                        SNEAKER & SPORTSWEAR COLLECTION
                    </span>
                    <h1 class="text-white" style="font-size: 2.8rem; font-weight: 900; letter-spacing: -0.5px;">
                        GIÀY THỂ THAO & SNEAKER
                    </h1>
                    <p class="mb-0 text-white-50" style="font-size: 16px;">
                        Nike • Adidas • Puma • New Balance • Converse • Vans • Asics | Đủ Size 36 - 45
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Product Grid Items -->
@await Html.PartialAsync("ProductItem", Model)
