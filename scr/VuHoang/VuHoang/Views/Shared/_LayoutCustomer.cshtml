<!DOCTYPE html>

<html>
<head>
    <!-- The above 4 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>@(ViewBag.Title ?? "SNEAKER STORE - Cửa Hàng Giày Thể Thao & Sneaker")</title>
    <meta charset="UTF-8" />
    <meta name="description" content="Cửa hàng chuyên kinh doanh giày thể thao và giày sneaker từ Nike, Adidas, Puma, New Balance, Converse, Vans, Asics." />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Favicon  -->
    <link rel="icon" href="~/img/core-img/favicon.ico" />

    <!-- Icons CSS -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />

    <!-- Core Style CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/core-style.css" />
    <link rel="stylesheet" href="~/css/classy-nav.min.css" />
    <link rel="stylesheet" href="~/css/milktea-theme.css" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    @RenderSection("Styles", required: false)
</head>

<body>
    <div>
        <!-- ##### Header Area Start ##### -->
        <header class="header_area">
            <div class="classy-nav-container breakpoint-off d-flex align-items-center justify-content-between">
                <!-- Classy Menu -->
                <nav class="classy-navbar" id="essenceNav">
                    <!-- Modern Sneaker Store Logo -->
                    <a class="nav-brand teahouse-brand" asp-controller="Home" asp-action="Index">
                        <div class="teahouse-brand-icon">
                            <i class="fas fa-running" aria-hidden="true"></i>
                        </div>
                        <div class="teahouse-brand-text">
                            <span class="teahouse-brand-name">SNEAKER<span> STORE</span></span>
                            <span class="teahouse-brand-tagline">ATHLETIC & LIFESTYLE</span>
                        </div>
                    </a>
                    <!-- Navbar Toggler -->
                    <div class="classy-navbar-toggler">
                        <span class="navbarToggler">
                            <span></span><span></span><span></span>
                        </span>
                    </div>
                    <!-- Menu -->
                    <div class="classy-menu">
                        <!-- close btn -->
                        <div class="classycloseIcon">
                            <div class="cross-wrap">
                                <span class="top"></span><span class="bottom"></span>
                            </div>
                        </div>
                        <!-- Nav Start -->
                        <div class="classynav">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                                <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1000">Giày Nike</a></li>
                                <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1001">Giày Adidas</a></li>
                                <li>
                                    <a asp-controller="HangHoa" asp-action="Index">Thương hiệu</a>
                                    <ul class="dropdown">
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1000">Nike</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1001">Adidas</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1002">Puma</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1003">New Balance</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1004">Converse</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1005">Vans</a></li>
                                        <li><a asp-controller="HangHoa" asp-action="Index" asp-route-loai="1008">Asics</a></li>
                                    </ul>
                                </li>
                                <li><a asp-controller="HangHoa" asp-action="Index" asp-route-gioitinh="Nam">Giày nam</a></li>
                                <li><a asp-controller="HangHoa" asp-action="Index" asp-route-gioitinh="Nu">Giày nữ</a></li>
                                <li><a asp-controller="HangHoa" asp-action="Index" asp-route-trangthai="khuyenmai">Khuyến mãi</a></li>
                                <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                            </ul>
                        </div>
                        <!-- Nav End -->
                    </div>
                </nav>

                <!-- Header Meta Data -->
                <div class="header-meta d-flex clearfix justify-content-end align-items-center">
                    <!-- Search Area -->
                    <div class="search-area">
                        <form asp-action="Search" asp-controller="HangHoa" method="get">
                            <input type="search"
                                   name="query"
                                   id="searchText"
                                   placeholder="Tìm giày thể thao, thương hiệu..." />
                            <button id="searchButton" type="submit">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                    <!-- Favourite Area -->
                    <div class="favourite-area">
                        <a href="/HangHoa/Index?trangthai=banchay" class="header-action-btn" title="Yêu thích">
                            <i class="fa fa-heart-o"></i>
                        </a>
                    </div>

                    <!-- User Login Info -->
                    <div class="user-login-info">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <a class="header-action-btn dropdown-toggle" href="#" id="userMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fa fa-user-circle-o"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right" style="min-width:12rem" aria-labelledby="userMenu">
                                    <div class="px-3 py-2 border-bottom text-muted small">
                                        Xin chào, <strong>@User.Identity.Name</strong>
                                    </div>
                                    <a class="dropdown-item" asp-controller="KhachHang" asp-action="Profile">
                                        <i class="fa fa-user-o text-muted"></i> Thông tin cá nhân
                                    </a>
                                    <a class="dropdown-item" asp-controller="Cart" asp-action="HistoryBill">
                                        <i class="fa fa-file-text-o text-muted"></i> Đơn hàng của tôi
                                    </a>
                                    <a class="dropdown-item" asp-controller="KhachHang" asp-action="DoiMatKhau">
                                        <i class="fa fa-key text-muted"></i> Đổi mật khẩu
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item text-danger" asp-controller="KhachHang" asp-action="DangXuat">
                                        <i class="fa fa-sign-out"></i> Đăng xuất
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="header-action-btn" asp-controller="KhachHang" asp-action="DangNhap" title="Đăng nhập">
                                <i class="fa fa-user-o"></i>
                            </a>
                        }
                    </div>
                    <!-- Cart Area -->
                    <div class="cart-area">
                        @await Component.InvokeAsync("Cart")
                    </div>
                </div>
            </div>
        </header>
        <!-- ##### Header Area End ##### -->


        <div class="hero-header">
            @RenderBody()
        </div>

        <!-- Footer Start -->
        @await Html.PartialAsync("_Footer")
        <!-- Footer End -->
    </div>


    <!-- ##### Footer Area End ##### -->
    <!-- jQuery (Necessary for All JavaScript Plugins) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <!-- Popper js -->
    <script src="~/js/popper.min.js"></script>
    <!-- Bootstrap js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.min.js"></script>
    <!-- Plugins js -->
    <script src="~/js/plugins.js"></script>
    <!-- Classy Nav js -->
    <script src="~/js/classy-nav.min.js"></script>
    <!-- Active js -->
    <script src="~/js/active.js"></script>
    <!-- Carousel js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.2.1/owl.carousel.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        $(document).ready(function () {
            $("#searchButton").click(function () {
                let url = `/HangHoa/Search?query=` + encodeURIComponent($("#searchText").val());
                window.location.href = url;
            });
        });
    </script>

</body>
</html>
