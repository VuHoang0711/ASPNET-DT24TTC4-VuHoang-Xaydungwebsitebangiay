<!-- ##### FOOTER AREA START ##### -->
<footer class="footer_area clearfix">
    <div class="container">
        <div class="row">
            <!-- Brand & Slogan -->
            <div class="col-12 col-md-4 mb-4">
                <div class="footer-brand-box mb-3">
                    <a class="teahouse-brand d-inline-flex align-items-center mb-3" asp-controller="Home" asp-action="Index">
                        <div class="teahouse-brand-icon" style="width: 42px; height: 42px; font-size: 20px;">
                            <i class="fas fa-running"></i>
                        </div>
                        <div class="teahouse-brand-text ml-2">
                            <span class="footer-brand-title mb-0">SNEAKER<span> STORE</span></span>
                        </div>
                    </a>
                    <p class="footer-tagline">
                        “Bứt phá phong cách – Chinh phục mọi bước chân.”<br>
                        Hệ thống cửa hàng chuyên kinh doanh giày thể thao và sneaker từ Nike, Adidas, Puma, New Balance, Converse, Vans, Asics với dịch vụ đổi size 30 ngày và bảo hành chu đáo.
                    </p>
                    <div class="footer-social-box">
                        <a href="https://facebook.com" class="footer-social-btn" target="_blank" title="Facebook">
                            <i class="fa fa-facebook"></i>
                        </a>
                        <a href="https://instagram.com" class="footer-social-btn" target="_blank" title="Instagram">
                            <i class="fa fa-instagram"></i>
                        </a>
                        <a href="https://tiktok.com" class="footer-social-btn" target="_blank" title="TikTok">
                            <i class="fa fa-music"></i>
                        </a>
                        <a href="mailto:contact@sneakerstore.vn" class="footer-social-btn" title="Email">
                            <i class="fa fa-envelope-o"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Menu Navigation Links -->
            <div class="col-6 col-md-2 mb-4">
                <div class="footer_heading">
                    <h6>DANH MỤC GIÀY</h6>
                </div>
                <div class="footer_widget_menu">
                    <ul class="list-unstyled">
                        <li><a asp-action="Index" asp-controller="Home">Trang Chủ</a></li>
                        <li><a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1000">Giày Nike</a></li>
                        <li><a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1001">Giày Adidas</a></li>
                        <li><a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1009">Giày Chạy Bộ</a></li>
                        <li><a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1010">Giày Bóng Rổ</a></li>
                        <li><a asp-action="Index" asp-controller="HangHoa" asp-route-trangthai="khuyenmai">Khuyến Mãi</a></li>
                    </ul>
                </div>
            </div>

            <!-- Support & Policies -->
            <div class="col-6 col-md-3 mb-4">
                <div class="footer_heading">
                    <h6>HỖ TRỢ KHÁCH HÀNG</h6>
                </div>
                <div class="footer_widget_menu">
                    <ul class="list-unstyled">
                        <li><a asp-action="Guide" asp-controller="Home">Hướng dẫn chọn size & Mua hàng</a></li>
                        <li><a asp-action="Quality" asp-controller="Home">Chính sách bảo hành & Đổi trả</a></li>
                        <li><a asp-action="Privacy" asp-controller="Home">Chính sách bảo mật thông tin</a></li>
                        <li><a asp-action="Blog" asp-controller="Home">Về chúng tôi</a></li>
                        <li><a asp-controller="Cart" asp-action="HistoryBill">Tra cứu đơn hàng</a></li>
                    </ul>
                </div>
            </div>

            <!-- Store & Contact Information -->
            <div class="col-12 col-md-3 mb-4">
                <div class="footer_heading">
                    <h6>THÔNG TIN LIÊN HỆ</h6>
                </div>
                <div class="footer-contact-info small text-light" style="line-height: 2;">
                    <p class="mb-2">
                        <i class="fa fa-phone text-warning mr-2"></i> <strong>Hotline tư vấn chọn size:</strong><br />
                        <a href="tel:19006888" style="color: #FF8573; font-size: 18px; font-weight: 800;">1900 6888</a> (8:00 - 22:30)
                    </p>
                    <p class="mb-2">
                        <i class="fa fa-envelope text-warning mr-2"></i> <strong>Email hỗ trợ:</strong><br />
                        contact@sneakerstore.vn
                    </p>
                    <p class="mb-2">
                        <i class="fa fa-map-marker text-warning mr-2"></i> <strong>Cửa hàng chính:</strong><br />
                        129 Đ. Số 8, Linh Xuân, TP. Thủ Đức, TP. Hồ Chí Minh
                    </p>
                    <div class="mt-3">
                        <span class="badge badge-success px-3 py-1 font-weight-bold" style="background:#16A34A;">
                            <i class="fa fa-circle mr-1"></i> Showroom mở cửa mỗi ngày
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4 pt-4 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
            <div class="col-12 text-center small" style="color: #9CA3AF;">
                <p class="mb-0">
                    &copy; @DateTime.Now.Year <strong>SNEAKER STORE</strong> • Hệ Thống Cửa Hàng Giày Thể Thao & Sneaker. All Rights Reserved.
                </p>
            </div>
        </div>
    </div>
</footer>
