                        </div>
                        <a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1011" class="btn-teahouse-peach">
                            CHỌN SIZE
                        </a>
                    </div>
                </div>
            </div>

            <!-- Promo 3 -->
            <div class="col-12 col-md-4 mb-4">
                <div class="combo-card">
                    <span class="combo-tag">BACK TO SCHOOL</span>
                    <h3 class="combo-title">CONVERSE & VANS CLASSIC</h3>
                    <p class="combo-desc">Ưu đãi dành cho học sinh - sinh viên khi mua Converse Chuck 70, Chuck Taylor và Vans Old Skool.</p>
                    <div class="combo-deal-box">
                        <div>
                            <span class="combo-save">Chỉ từ 1.550.000đ</span>
                            <small class="text-muted d-block">Miễn phí giao hàng toàn quốc</small>
                        </div>
                        <a asp-action="Index" asp-controller="HangHoa" asp-route-loai="1004" class="btn-teahouse-peach">
                            SĂN ƯU ĐÃI
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
