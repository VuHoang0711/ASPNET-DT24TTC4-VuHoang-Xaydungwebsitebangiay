@{
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <div class="p-5 rounded" style="background:#FFFFFF; border: 1px solid var(--border-soft); box-shadow: var(--shadow-md); border-radius: 24px;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: #FFEFEA; color: #FF6F59; display: inline-flex; align-items: center; justify-content: center; font-size: 36px; margin-bottom: 24px;">
                    <i class="fa fa-exclamation-triangle"></i>
                </div>
                <h2 class="font-weight-bold mb-3 text-danger">THANH TOÁN THẤT BÀI</h2>
                
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small">@TempData["Message"]</div>
                }

                <p class="text-muted mb-4" style="line-height: 1.7;">
                    Giao dịch chưa được hoàn tất hoặc đã bị hủy từ cổng thanh toán. Giỏ hàng của bạn vẫn được lưu giữ an toàn. Bạn có thể thử lại bằng hình thức thanh toán COD hoặc thanh toán lại.
                </p>

                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-controller="Cart" asp-action="Checkout" class="btn-teahouse mr-2 mb-2">
                        <i class="fa fa-refresh mr-1"></i> THỬ THANH TOÁN LẠI
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="btn-teahouse-outline mb-2">
                        <i class="fa fa-shopping-bag mr-1"></i> VỀ GIỎ HÀNG
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>